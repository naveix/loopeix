    "run:plan": {
      "aliases": [],
      "args": {
        "pack": {
          "description": "compile pack directory",
          "name": "pack",
          "required": true
        }
      },
      "description": "Consumes a compiled `loopeix compile --pack-dir` output and writes a planned run directory with intake brief and resolved-run-plan.json. HOLD packs are refused.",
      "enableJsonFlag": true,
      "examples": [
        "<%= config.bin %> run plan .loopeix/compiles/date-parser --engine codex --workspace-root ."
      ],
      "flags": {
        "approve-compiled-pack": {
          "allowNo": false,
          "description": "confirm the compiled pack was reviewed and approved for planning",
          "name": "approve-compiled-pack",
          "type": "boolean"
        },
        "engine": {
          "description": "engine adapter to plan for",
          "hasDynamicHelp": false,
          "multiple": false,
          "name": "engine",
          "options": [
            "codex",
            "claude"
          ],
          "required": true,
          "type": "option"
        },
        "json": {
          "allowNo": false,
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
          "name": "json",
          "type": "boolean"
        },
        "workspace-root": {
          "default": "<S35_BASELINE_SOURCE_ROOT>",
          "description": "approved workspace root (run dir = <workspace-root>/.loopeix/loops/<family>/runs/<run-id>)",
          "hasDynamicHelp": false,
          "multiple": false,
          "name": "workspace-root",
          "type": "option"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "run:plan",
      "isESM": true,
      "pluginAlias": "loopeix",
      "pluginName": "loopeix",
      "pluginType": "core",
      "relativePath": [
        "dist",
        "commands",
        "run",
        "plan.js"
      ],
      "strict": true,
      "summary": "Create an approved resolved run plan from a compiled pack."
    },
