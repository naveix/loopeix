    "spec:validate": {
      "aliases": [],
      "args": {
        "file": {
          "description": "path to the Loopeix YAML file",
          "name": "file",
          "required": true
        }
      },
      "description": "Runs structural (schema) then relational (invariant) validation. Exit 0 if valid, 1 if invalid.",
      "enableJsonFlag": true,
      "examples": [
        "<%= config.bin %> spec validate ./my-loop.loop.yaml"
      ],
      "flags": {
        "json": {
          "allowNo": false,
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
