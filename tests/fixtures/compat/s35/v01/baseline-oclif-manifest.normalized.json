{
  "commands": {
    "compile": {
      "aliases": [],
      "args": {},
      "description": "Routes a user prompt through the local item catalog. Safe, clear prompts produce a draft .loop.yaml; risky or ambiguous prompts return HOLD instead of fabricating authority.",
      "enableJsonFlag": true,
      "examples": [
        "<%= config.bin %> compile --prompt \"Fix the failing date parser test and prove the fix\" --pack-dir .loopeix/compiles/date-parser"
      ],
      "flags": {
        "json": {
          "allowNo": false,
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
          "name": "json",
          "type": "boolean"
        },
        "out": {
          "description": "write the generated .loop.yaml to this path",
          "hasDynamicHelp": false,
          "multiple": false,
          "name": "out",
          "type": "option"
        },
        "pack-dir": {
          "description": "write compile records, report, and generated loop if compiled to this directory",
          "hasDynamicHelp": false,
          "multiple": false,
          "name": "pack-dir",
          "type": "option"
        },
        "prompt": {
          "description": "vague or scoped user prompt to compile",
          "hasDynamicHelp": false,
          "multiple": false,
          "name": "prompt",
          "required": true,
          "type": "option"
        },
        "workspace-root": {
          "default": "<S35_BASELINE_SOURCE_ROOT>",
          "description": "approved workspace root for the compiled loop",
          "hasDynamicHelp": false,
          "multiple": false,
          "name": "workspace-root",
          "type": "option"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "compile",
      "isESM": true,
      "pluginAlias": "loopeix",
      "pluginName": "loopeix",
      "pluginType": "core",
      "relativePath": [
        "dist",
        "commands",
        "compile.js"
      ],
      "strict": true,
      "summary": "Compile a vague prompt into a bounded Loopeix loop or an explicit HOLD."
    },
