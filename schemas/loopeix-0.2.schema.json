{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopeix.dev/schemas/loopeix-0.2.schema.json",
  "title": "Loopeix 0.2",
  "x-loopeix-schema-version": "0.2",
  "x-compatibility-policy": "additive within a minor version; breaking changes bump the version",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2"
    },
    "loop_family": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d{3}$"
    },
    "trigger": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "operator-invoked"
        },
        "entrypoint": {
          "type": "string",
          "enum": [
            "compile",
            "run-plan",
            "run-start"
          ]
        }
      },
      "required": [
        "type",
        "entrypoint"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "statement": {
          "$ref": "#/$defs/__schema1"
        },
        "success_criteria": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        }
      },
      "required": [
        "statement",
        "success_criteria"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "description": {
            "$ref": "#/$defs/__schema2"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "description",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "context_contract": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "untrusted_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": [
        "required",
        "forbidden",
        "untrusted_sources"
      ],
      "additionalProperties": false
    },
    "workflow_pattern": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "prompt-chaining",
            "routing",
            "parallel-specialists",
            "orchestrator-workers",
            "evaluator-optimizer"
          ]
        },
        "phases": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": [
        "type",
        "phases"
      ],
      "additionalProperties": false
    },
    "roles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "tasks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "tool_grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "tool": {
            "$ref": "#/$defs/__schema2"
          },
          "scope": {
            "$ref": "#/$defs/__schema2"
          },
          "risk_tier": {
            "$ref": "#/$defs/__schema6"
          },
          "requires_approval": {
            "type": "boolean"
          }
        },
        "required": [
