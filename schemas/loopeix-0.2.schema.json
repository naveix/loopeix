          "required": {
            "type": "boolean"
          },
          "producer_task": {
            "$ref": "#/$defs/__schema0"
          },
          "acceptance_checks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema2"
