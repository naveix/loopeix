    },
    "gates": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "type": {
            "type": "string",
            "enum": [
              "command",
              "manual-review",
              "source-citation",
              "browser-check",
              "schema-validation",
              "custom"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "command": {
            "$ref": "#/$defs/__schema2"
          },
          "success_condition": {
            "$ref": "#/$defs/__schema1"
          },
          "applicability": {
            "$ref": "#/$defs/__schema8"
          },
          "prerequisites": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema9"
            }
          },
          "evidence_requirement_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "evaluator_binding": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "required": [
          "id",
          "type",
          "required",
          "success_condition",
          "applicability",
          "prerequisites",
          "evidence_requirement_refs",
          "evaluator_binding"
        ],
        "additionalProperties": false
      }
    },
    "evidence_requirements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema12"
      }
    },
    "risk_controls": {
      "type": "object",
      "properties": {
        "max_tier_without_approval": {
