      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "path": {
            "$ref": "#/$defs/__schema2"
          },
          "type": {
            "type": "string",
            "enum": [
              "markdown",
              "json",
              "jsonl",
              "yaml",
              "html",
              "text",
              "image",
              "other"
