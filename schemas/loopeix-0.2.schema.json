    "limit_policy": {
      "type": "object",
      "properties": {
        "max_loop_attempts": {
          "$ref": "#/$defs/__schema17"
        },
        "max_elapsed_ms": {
          "$ref": "#/$defs/__schema17"
        },
        "max_tool_calls": {
          "$ref": "#/$defs/__schema17"
        },
        "max_workers": {
          "$ref": "#/$defs/__schema17"
        },
        "max_output_bytes": {
          "$ref": "#/$defs/__schema17"
        },
        "control_plane_output_reserve_bytes": {
          "$ref": "#/$defs/__schema17"
        },
        "max_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema17"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_cost_minor_units": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema17"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "max_loop_attempts",
        "max_elapsed_ms",
        "max_tool_calls",
        "max_workers",
        "max_output_bytes",
        "control_plane_output_reserve_bytes",
        "max_tokens",
        "max_cost_minor_units",
        "cost_currency"
      ],
      "additionalProperties": false
    },
    "retry_policy": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_ref": {
                "$ref": "#/$defs/__schema0"
              },
              "failure_class": {
                "$ref": "#/$defs/__schema21"
              },
              "retryable": {
                "type": "boolean"
              },
              "max_task_executions": {
                "$ref": "#/$defs/__schema17"
              },
              "backoff": {
                "type": "string",
                "enum": [
                  "none",
                  "fixed",
                  "exponential"
                ]
              },
              "base_delay_ms": {
                "$ref": "#/$defs/__schema22"
              },
              "max_delay_ms": {
                "$ref": "#/$defs/__schema22"
              }
            },
            "required": [
              "task_ref",
              "failure_class",
              "retryable",
              "max_task_executions",
              "backoff",
              "base_delay_ms",
              "max_delay_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "rules"
      ],
      "additionalProperties": false
    },
    "recovery_policy": {
      "type": "object",
      "properties": {
        "resume_from": {
          "type": "string",
          "const": "last-durable-boundary"
        },
        "require_input_hash_match": {
          "type": "boolean",
          "const": true
        },
        "require_policy_hash_match": {
          "type": "boolean",
          "const": true
        },
        "on_unknown_outcome": {
          "type": "string",
          "const": "hold"
        },
        "terminal_compensation": {
          "type": "string",
          "const": "before-terminal-seal"
        },
        "activation_reasons": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "terminal-failure"
            },
            {
              "type": "string",
              "const": "terminal-exhaustion"
            },
            {
              "type": "string",
              "const": "terminal-stall"
            },
            {
              "type": "string",
              "const": "abort-recovery"
            }
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": false
        },
        "max_compensation_workers": {
          "type": "number",
          "const": 1
        },
        "reserve": {
          "type": "object",
          "properties": {
            "max_elapsed_ms": {
              "$ref": "#/$defs/__schema22"
            },
            "max_tool_calls": {
              "$ref": "#/$defs/__schema22"
            },
            "max_output_bytes": {
              "$ref": "#/$defs/__schema22"
            },
            "max_tokens": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema22"
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_cost_minor_units": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema22"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "max_elapsed_ms",
            "max_tool_calls",
            "max_output_bytes",
            "max_tokens",
            "max_cost_minor_units"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "resume_from",
        "require_input_hash_match",
        "require_policy_hash_match",
        "on_unknown_outcome",
        "terminal_compensation",
        "activation_reasons",
        "max_compensation_workers",
        "reserve"
      ],
      "additionalProperties": false
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "$ref": "#/$defs/__schema0"
          },
          "effects": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema23"
            }
          }
        },
        "required": [
          "task_id",
          "effects"
        ],
        "additionalProperties": false
      }
    },
    "compensations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "for_task": {
            "$ref": "#/$defs/__schema0"
          },
          "for_effect": {
            "$ref": "#/$defs/__schema0"
          },
          "action_task": {
            "$ref": "#/$defs/__schema0"
          },
          "preconditions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema24"
            }
          },
          "verification_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "may_fail": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "id",
          "for_task",
          "for_effect",
          "action_task",
          "preconditions",
          "verification_refs",
          "may_fail"
        ],
        "additionalProperties": false
      }
    },
    "retro": {
      "type": "object",
      "properties": {
        "creates": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "creates"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "loop_family",
    "version",
    "trigger",
    "goal",
    "inputs",
    "context_contract",
    "workflow_pattern",
    "roles",
    "tasks",
    "tool_grants",
    "artifacts",
    "gates",
    "evaluations",
    "evidence_requirements",
    "risk_controls",
    "progress",
    "stop_policy",
    "limit_policy",
    "retry_policy",
    "recovery_policy",
    "side_effects",
    "compensations",
    "retro"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
