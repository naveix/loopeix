{
  "name": "loopeix",
  "version": "0.1.0",
  "description": "Design, run, and verify repeatable AI work loops locally, with tamper-evident evidence and truthful reports. Flagship add-on: the Claims Check, a lie detector for agent pull requests with signed, offline-verifiable receipts.",
  "keywords": [
    "ai-agents",
    "verification",
    "receipts",
    "provenance",
    "claims-check",
    "code-review",
    "codex",
    "claude-code",
    "evidence",
    "signed-receipts",
    "local-first",
    "cli"
  ],
  "homepage": "https://github.com/naveix/loopeix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naveix/loopeix.git"
  },
  "bugs": {
    "url": "https://github.com/naveix/loopeix/issues"
  },
  "author": "Naveix",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0"
    }
  },
  "bin": {
    "loopeix": "./bin/run.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "bin",
    "dist",
    "schemas",
    "oclif.manifest.json",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "oclif": {
    "bin": "loopeix",
    "dirname": "loopeix",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "spec": {
        "description": "Work with Loopeix files (validate, inspect)."
      },
      "report": {
        "description": "Build and open local run reports."
      },
      "run": {
        "description": "Inspect and recover local runs."
      }
    }
  },
  "scripts": {
    "prebuild": "node scripts/prebuild-clean.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "fixtures:receipts": "tsx scripts/generate-receipt-fixtures.ts",
    "prepack": "pnpm build && pnpm schema:generate && oclif manifest"
  },
  "dependencies": {
    "@oclif/core": "4.11.14",
    "canonicalize": "3.0.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oclif": "4.23.24",
    "tsx": "4.22.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
